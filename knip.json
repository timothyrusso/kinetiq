{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "scripts/*.{js,ts}",
    "src/**/*.android.{ts,tsx}",
    "targets/**/expo-target.config.js",
    "modules/*/index.ts",
    "modules/**/*.android.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{js,ts}",
    "modules/**/*.ts"
  ],
  "paths": {
    "@/ui/controls/*": [
      "src/ui/controls/*/index.ios.tsx",
      "src/ui/controls/*/index.tsx"
    ],
    "@/*": [
      "src/*"
    ]
  },
  "ignoreBinaries": [
    "rsvg-convert",
    "swiftlint",
    "swift"
  ],
  "ignoreDependencies": [
    "expo-updates"
  ]
}
