{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "scripts/*.{js,ts}",
    "features/core/*/index.ts",
    "features/profile/index.ts",
    "features/**/*.{ios,android}.{ts,tsx}",
    "targets/**/expo-target.config.js"
  ],
  "project": ["app/**/*.{ts,tsx}", "features/**/*.{ts,tsx}", "scripts/**/*.{js,ts}"],
  "paths": {
    "@/features/core/design-system/controls/*": [
      "features/core/design-system/controls/*/index.ios.tsx",
      "features/core/design-system/controls/*/index.tsx"
    ],
    "@/*": ["*"]
  },
  "ignoreBinaries": ["rsvg-convert", "swiftlint", "swift"],
  "ignoreDependencies": ["expo-updates", "@commitlint/config-conventional"]
}
