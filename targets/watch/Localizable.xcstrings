    "sync.rejected.version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone sent routines from another Kinetiq version. Update Kinetiq on both devices."
          }
